# Copy to .env for local development. Never commit .env or real values.
# Names follow ARCHITECTURE.md Section 10. Staging/production values live in Render and Vercel settings only.

# --- Backend ---
APP_ENV=local
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
SURPLUS_API_KEY=
RESEND_API_KEY=
DIGEST_FROM_ADDRESS=
DIGEST_TO_ADDRESS=
DEFILLAMA_API_KEY=
NANSEN_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=
X_API_KEY=
X_RESELLER_API_KEY=
X_HISTORY_API_KEY=
GITHUB_TOKEN=
MONTHLY_BUDGET_USD=700
# Dashboard addresses allowed to call the API from a browser (comma-separated). Not a secret.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional pattern for dashboard addresses that change per deployment (Vercel previews). Not a secret.
CORS_ALLOWED_ORIGIN_REGEX=

# Throwaway database for the backend tests. They wipe it on every run. Local and CI only.
TEST_DATABASE_URL=

# --- Dashboard (apps/web) ---
# Where the dashboard finds the API. Not a secret.
VITE_API_BASE_URL=http://localhost:8000
